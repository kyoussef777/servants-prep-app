{
  "expo": {
    "name": "St. Mark Portal",
    "slug": "st-mark-portal",
    "scheme": "stmarkportal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon.png",
    "ios": {
      "icon": "./assets/app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "org.stmark.ministryportal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#5C1A1A"
      },
      "package": "org.stmark.ministryportal",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "../../public/sunday-school-favicon.png",
          "imageWidth": 152,
          "resizeMode": "contain",
          "backgroundColor": "#5C1A1A",
          "dark": {
            "image": "../../public/sunday-school-favicon.png",
            "backgroundColor": "#5C1A1A"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
